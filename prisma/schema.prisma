generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                    String                @id @default(cuid())
  name                  String
  subdomain             String                @unique
  customDomain          String?               @unique
  logo                  String?
  logoLight             String?
  logoDark              String?
  favicon               String?
  primaryColor          String                @default("#000000")
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  plan                  Plan                  @default(STARTER)
  storageLimit          Int                   @default(10240)
  stripeCustomerId      String?
  aiCredits             Int                   @default(0)
  customRevenue         Int                   @default(0)
  customRevenueCurrency String                @default("USD")
  globalMarketplaceEnabled Boolean            @default(false)
  courseCredits         Int                   @default(0)
  openaiKey             String?
  availableLocales      String[]              @default(["en"])
  defaultLocale         String                @default("en")
  announcements         Announcement[]
  translations          Translation[]
  users                 User[]
  certificateTemplates  CertificateTemplate[] @relation("TenantTemplates")
  courses               Course[]
  jobRoles              JobRole[]
  teams                 Team[]
  marketplaceClaims     MarketplaceClaim[]
}

model User {
  id                String                 @id @default(cuid())
  email             String
  name              String?
  password          String
  role              Role                   @default(LEARNER)
  tenantId          String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  isActive          Boolean                @default(true)
  activityLogs      ActivityLog[]
  enrollments       Enrollment[]
  certificates      IssuedCertificate[]
  progress          LessonProgress[]
  notes             Note[]
  quizAttempts      QuizAttempt[]
  reviews           Review[]
  submissions       Submission[]
  assignedCoursesBy TeamCourseAssignment[] @relation("AssignedCourseBy")
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  managedTeams      Team[]                 @relation("ManagerTeams")
  teams             Team[]                 @relation("MemberTeams")
  jobRoles          JobRole[]              @relation("UserJobRoles")

  @@unique([email, tenantId])
}

model Course {
  id                    String                 @id @default(cuid())
  title                 String
  description           String?
  thumbnail             String?
  isPublished           Boolean                @default(false)
  tenantId              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  captions              Boolean                @default(false)
  languages             String                 @default("English")
  skillLevel            String                 @default("All Levels")
  isMarketplace         Boolean                @default(false)
  exclusiveRoleId       String?
  exclusiveTeamId       String?
  exclusiveRole         JobRole?               @relation("ExclusiveCourses", fields: [exclusiveRoleId], references: [id])
  exclusiveTeam         Team?                  @relation("ExclusiveTeamCourses", fields: [exclusiveTeamId], references: [id])
  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  enrollments           Enrollment[]
  certificates          IssuedCertificate[]
  modules               Module[]
  notes                 Note[]
  resources             Resource[]
  reviews               Review[]
  teamAssignments       TeamCourseAssignment[]
  certificateEnabled    Boolean                @default(false)
  certificateTemplateId String?
  certificateTemplate   CertificateTemplate?   @relation("CourseTemplate", fields: [certificateTemplateId], references: [id])
  isGlobal              Boolean                @default(false)
  clonedFromId          String?
  marketplaceClaims     MarketplaceClaim[]     @relation("ClaimedCourse")
}

model Module {
  id        String     @id @default(cuid())
  title     String
  order     Int
  courseId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isActive  Boolean    @default(true)
  lessons   Lesson[]
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources Resource[]
}

model Lesson {
  id               String           @id @default(cuid())
  title            String
  content          String?
  videoUrl         String?
  pdfUrl           String?
  order            Int
  moduleId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  hasCaptions      Boolean          @default(false)
  isActive         Boolean          @default(true)
  transcript       String?
  transcriptStatus String           @default("NONE")
  type             LessonType       @default(TEXT)
  assignments      Assignment[]
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress         LessonProgress[]
  notes            Note[]
  quiz             Quiz?
  resources        Resource[]
}

model Quiz {
  id            String        @id @default(cuid())
  title         String
  description   String?
  passingScore  Int           @default(70)
  lessonId      String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isRandomized  Boolean       @default(false)
  maxAttempts   Int           @default(0)
  randomCount   Int           @default(0)
  retakeAllowed Boolean       @default(true)
  questions     Question[]
  lesson        Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts      QuizAttempt[]
}

model Question {
  id      String   @id @default(cuid())
  quizId  String
  text    String
  type    String   @default("MULTIPLE_CHOICE")
  order   Int
  options Option[]
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  score     Int
  passed    Boolean
  answers   Json?
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Resource {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int?
  lessonId  String?
  moduleId  String?
  courseId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module    Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastPosition String?
  startedAt    DateTime  @default(now())
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documentUrl String?
  imageUrl    String?
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model Assignment {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  lessonId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  content      String?
  fileUrl      String?
  grade        Int?
  feedback     String?
  userId       String
  assignmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, assignmentId])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CertificateTemplate {
  id              String   @id @default(cuid())
  name            String
  backgroundImage String?
  designFields    Json?
  isActive        Boolean  @default(true)
  isGlobal        Boolean  @default(false)
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant?  @relation("TenantTemplates", fields: [tenantId], references: [id])
  courses         Course[] @relation("CourseTemplate")
}

model IssuedCertificate {
  id             String   @id @default(cuid())
  certificateUrl String
  userId         String
  courseId       String
  issuedAt       DateTime @default(now())
  uniqueCode     String   @unique
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  content   String
  timestamp Float    @default(0)
  userId    String
  courseId  String
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  content   String?
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model JobRole {
  id               String   @id @default(cuid())
  name             String
  description      String?
  tenantId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)
  exclusiveCourses Course[] @relation("ExclusiveCourses")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users            User[]   @relation("UserJobRoles")
}

model Team {
  id                String                 @id @default(cuid())
  name              String
  description       String?
  tenantId          String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  isActive          Boolean                @default(true)
  exclusiveCourses  Course[]               @relation("ExclusiveTeamCourses")
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseAssignments TeamCourseAssignment[]
  managers          User[]                 @relation("ManagerTeams")
  members           User[]                 @relation("MemberTeams")
}

model TeamCourseAssignment {
  id           String   @id @default(cuid())
  teamId       String
  courseId     String
  assignedById String
  createdAt    DateTime @default(now())
  assignedBy   User     @relation("AssignedCourseBy", fields: [assignedById], references: [id])
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, courseId])
}

model MarketplaceClaim {
  id             String   @id @default(cuid())
  tenantId       String
  courseId       String
  sourceCourseId String
  claimedAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course         Course   @relation("ClaimedCourse", fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceCourseId])
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  INSTRUCTOR
  TEACHER
  LEARNER
  PLATFORM_MANAGER
}

enum LessonType {
  VIDEO
  PPT
  QUIZ
  TEXT
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Translation {
  id         String   @id @default(cuid())
  entityId   String
  entityType String
  field      String
  locale     String
  value      String   @db.Text
  status     String   @default("PENDING")
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([entityId, entityType, field, locale, tenantId])
}
